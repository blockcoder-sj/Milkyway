# Copy to .env and enter your own key. Never commit .env.
# Every request requires a separate approval in the research chat.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

OPENAI_REASONING_EFFORT=none

# Free SEC EDGAR data. Contact is sent only in SEC request headers.
SEC_CONTACT_EMAIL=
# Free Korean disclosure data. Reserved for the OpenDART collector.
DART_API_KEY=
