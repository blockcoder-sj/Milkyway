{
    servers {
        timeouts {
            read_header 10s
            read_body 15s
            idle 30s
        }
        max_header_size 32KB
    }
}

{$DOMAIN:localhost} {
    encode zstd gzip

    request_body {
        max_size 16KB
    }

    @private path /docs* /openapi.json /metrics*
    respond @private 404

    reverse_proxy app:8000 {
        health_uri /health/live
        health_interval 15s
    }

    header {
        -Server
    }
}
