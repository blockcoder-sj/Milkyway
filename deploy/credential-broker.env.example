# Copy to deploy/credential-broker.env on the separate broker VM. Never place
# this file on the public app VM and never commit the filled file.
APP_ENV=production
BROKER_DOMAIN=credential-broker.internal.example

# Two different symmetric AES keys in OCI Vault. Only this VM's dynamic group
# receives KEY_ENCRYPT/KEY_DECRYPT for these exact OCIDs.
OCI_KMS_CRYPTO_ENDPOINT=https://replace-with-vault-crypto-endpoint
OCI_AI_CREDENTIAL_KEY_ID=ocid1.key.replace-with-ai-key-ocid
OCI_MARKET_CREDENTIAL_KEY_ID=ocid1.key.replace-with-market-key-ocid

# Must exactly match the main VM's tokens, while remaining different from each
# other and every other deployment secret.
CREDENTIAL_BROKER_APP_TOKEN=replace-with-at-least-32-random-characters
CREDENTIAL_BROKER_PAPER_TOKEN=replace-with-a-different-32-plus-random-value

AI_TIMEOUT_SECONDS=120

# Optional local model. It runs only beside the broker, so the public app never
# receives its server key. Enable the local-ai Compose profile explicitly.
COMPOSE_PROFILES=
LOCAL_AI_ENABLED=false
LOCAL_AI_BASE_URL=http://ai:8080/v1
LOCAL_AI_MODEL=Qwen2.5-Coder-7B-Instruct-GGUF
LOCAL_AI_MODEL_URL=https://huggingface.co/Qwen/Qwen2.5-Coder-7B-Instruct-GGUF/resolve/13fb94bfda8c8cf22497dc57b78f391a9acb426a/qwen2.5-coder-7b-instruct-q4_k_m.gguf?download=true
LOCAL_AI_API_KEY=replace-with-at-least-20-random-characters

QUOTE_PROVIDER=mock
MARKET_DATA_SHARING_ALLOWED=false
BROKER_API_KEY=
BROKER_API_SECRET=
BROKER_ACCOUNT_ID=
MAX_REQUEST_BODY_BYTES=16384
LOG_LEVEL=INFO
