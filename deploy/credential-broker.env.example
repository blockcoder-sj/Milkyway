# Copy to deploy/credential-broker.env on the separate broker VM. Never place
# this file on the public app VM and never commit the filled file.
APP_ENV=production
SERVICE_ROLE=broker
AUTHORITY_ENABLED=true
MEMBER_CREDENTIALS_ENABLED=true
SHARED_AI_ENABLED=true
BROKER_DOMAIN=credential-broker.internal.example
AUTHORITY_DATABASE_URL=postgresql+psycopg://milkyway_authority:replace-with-url-encoded-authority-password@db.private.internal.example:5432/quantclub?sslmode=verify-full&sslrootcert=/run/secrets/postgres_tls_ca
AUTHORITY_SESSION_SECRET=replace-with-an-independent-32-plus-character-authority-secret
POSTGRES_TLS_CA_PATH=/opt/milkyway/secrets/postgres-tls-ca.crt
PROMOTED_DATA_PATH=/opt/milkyway/promoted_data/generation-REPLACE_AFTER_REVIEW
OCI_KMS_CRYPTO_ENDPOINT=https://replace-with-vault-crypto-endpoint.oraclecloud.com
OCI_AI_CREDENTIAL_KEY_ID=ocid1.key.oc1.region.replace-with-ai-key
OCI_MARKET_CREDENTIAL_KEY_ID=ocid1.key.oc1.region.replace-with-market-key

# Must exactly match the main VM's tokens, while remaining different from each
# other and every other deployment secret.
CREDENTIAL_BROKER_APP_TOKEN=replace-with-at-least-32-random-characters
CREDENTIAL_BROKER_PAPER_TOKEN=replace-with-a-different-32-plus-random-value
CREDENTIAL_BROKER_BACKTEST_TOKEN=replace-with-another-distinct-32-plus-random-value

AI_TIMEOUT_SECONDS=120

# One operator-owned AI credential shared by club requests. Use provider=local
# only for the private local model profile. The external provider key is fetched
# from Vault by the broker instance principal. No plaintext key file is mounted.
SHARED_AI_PROVIDER=openai
SHARED_AI_MODEL=gpt-5.6-luna
OCI_SHARED_AI_SECRET_ID=ocid1.vaultsecret.oc1.region.replace-with-real-secret-id

# Optional local model. It runs only beside the broker, so the public app never
# receives its server key. Enable the local-ai Compose profile explicitly.
COMPOSE_PROFILES=
LOCAL_AI_ENABLED=false
LOCAL_AI_BASE_URL=http://ai:8080/v1
LOCAL_AI_MODEL=Qwen2.5-Coder-7B-Instruct-GGUF
LOCAL_AI_MODEL_URL=https://huggingface.co/Qwen/Qwen2.5-Coder-7B-Instruct-GGUF/resolve/13fb94bfda8c8cf22497dc57b78f391a9acb426a/qwen2.5-coder-7b-instruct-q4_k_m.gguf?download=true
LOCAL_AI_API_KEY_PATH=/opt/milkyway/secrets/local-ai-api-key

# Legacy shared-quote switches: keep defaults for personal brokerage mode.
QUOTE_PROVIDER=mock
MARKET_DATA_SHARING_ALLOWED=false
# paper selects the KIS virtual-investment endpoint; live selects the real quote
# endpoint but this application still never submits brokerage orders.
KIS_ENVIRONMENT=paper
KIS_QUOTE_TRANSPORT=rest
OCI_BROKER_API_KEY_SECRET_ID=
OCI_BROKER_API_SECRET_SECRET_ID=
BROKER_ACCOUNT_ID=
MAX_REQUEST_BODY_BYTES=16384
MAX_REQUEST_BODY_MESSAGES=64
REQUEST_BODY_READ_TIMEOUT_SECONDS=15
KMS_MAX_CONCURRENT_REQUESTS=4
QUOTE_MAX_CONCURRENT_REQUESTS=8
QUOTE_DEADLINE_SECONDS=20
QUOTE_MAX_PROVIDER_CALLS=125
QUOTE_INTERVAL_SECONDS=10
SHARED_QUOTE_BATCH_SIZE=200
SHARED_QUOTE_MAX_SYMBOLS_PER_TICK=200
SHARED_QUOTE_TICK_DEADLINE_SECONDS=30
QUOTE_MAX_AGE_SECONDS=180
LOG_LEVEL=INFO
