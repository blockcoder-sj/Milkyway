{
    admin off
    servers {
        timeouts {
            read_header 10s
            read_body 15s
            idle 30s
        }
        max_header_size 32KB
    }
}

{$BROKER_DOMAIN} {
    encode zstd gzip
    request_body {
        max_size 16KB
    }
    reverse_proxy credential-broker:8010
}
