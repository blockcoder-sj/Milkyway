[Unit]
Description=Milkyway Paper Trading Platform
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/milkyway
ExecStart=/usr/bin/docker compose --env-file deploy/.env up -d --remove-orphans
ExecStop=/usr/bin/docker compose --env-file deploy/.env down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
