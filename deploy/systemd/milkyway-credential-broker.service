[Unit]
Description=Milkyway credential provider-operation broker
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/milkyway
ExecStartPre=/bin/sh deploy/check-secret-file.sh deploy/credential-broker.env
ExecStart=/usr/bin/docker compose --env-file deploy/credential-broker.env -f compose.credential-broker.yaml up -d --build --remove-orphans
ExecStop=/usr/bin/docker compose --env-file deploy/credential-broker.env -f compose.credential-broker.yaml down
TimeoutStartSec=900
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
