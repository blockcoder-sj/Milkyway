# Copy to deploy/.env. Never commit the filled file.
APP_ENV=production
APP_NAME=Milkyway Quant Trading Lab
PUBLIC_BASE_URL=https://quant.example.com
DOMAIN=quant.example.com
ALLOWED_HOSTS=quant.example.com

POSTGRES_DB=quantclub
POSTGRES_USER=quantclub
POSTGRES_PASSWORD=replace-with-32-plus-random-characters
DATABASE_URL=postgresql+psycopg://quantclub:replace-with-url-encoded-password@postgres:5432/quantclub

SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_HOURS=12
CLUB_INVITE_CODE=replace-with-private-club-invite

DATASET_DIR=/app/data_cache/backtest_datasets/2026_equities_pit_20260824
SNAPSHOTS_GLOB=/app/data_cache/universe_snapshots/*.json
TERMINAL_EVENTS_PATH=/app/data_cache/universe_events/events.jsonl
SECTOR_MAP_PATH=/app/data_cache/_sector_map.json
# A scheduled provider can atomically replace this cache; the web app never
# fans out one external news request per signed-in member.
NEWS_FEED_PATH=/app/data_cache/news/news_feed.json

# mock uses the last completed close. kis requires an explicit licence check.
QUOTE_PROVIDER=mock
QUOTE_INTERVAL_SECONDS=30
MARKET_DATA_SHARING_ALLOWED=false
BROKER_API_KEY=
BROKER_API_SECRET=
BROKER_ACCOUNT_ID=

# Encrypts API keys entered by members. Generate a separate random value.
AI_CREDENTIAL_SECRET=replace-with-at-least-32-random-characters
AI_TIMEOUT_SECONDS=120

MAX_BACKTESTS_PER_USER_DAY=20
MAX_STRATEGIES_PER_USER=10
MAX_ACCOUNTS_PER_USER=3
MAX_USERS=40
WORKER_STALE_SECONDS=90
LOG_LEVEL=INFO
