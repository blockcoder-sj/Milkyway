# Copy to deploy/.env. Never commit the filled file.
APP_ENV=production
AUTHORITY_ENABLED=true
MEMBER_CREDENTIALS_ENABLED=true
SHARED_AI_ENABLED=true
APP_NAME=Milkyway Quant Trading Lab
PUBLIC_BASE_URL=https://quant.example.com
DOMAIN=quant.example.com
ALLOWED_HOSTS=quant.example.com

POSTGRES_DB=quantclub
POSTGRES_USER=quantclub_migration
POSTGRES_PASSWORD=replace-with-32-plus-random-characters
MIGRATION_DATABASE_URL=postgresql+psycopg://quantclub_migration:replace-with-url-encoded-password@postgres:5432/quantclub?sslmode=verify-full&sslrootcert=/run/secrets/postgres_tls_ca
APP_DB_PASSWORD=replace-with-a-distinct-32-character-app-password
PAPER_DB_PASSWORD=replace-with-a-distinct-32-character-paper-password
BACKTEST_DB_PASSWORD=replace-with-a-distinct-32-character-backtest-password
SCHEDULER_DB_PASSWORD=replace-with-a-distinct-32-character-scheduler-password
BACKUP_DB_PASSWORD=replace-with-a-distinct-32-character-backup-password
AUTHORITY_DB_PASSWORD=replace-with-a-distinct-32-character-authority-password
APP_DATABASE_URL=postgresql+psycopg://milkyway_app:replace-with-url-encoded-app-password@postgres:5432/quantclub?sslmode=verify-full&sslrootcert=/run/secrets/postgres_tls_ca
PAPER_DATABASE_URL=postgresql+psycopg://milkyway_paper:replace-with-url-encoded-paper-password@postgres:5432/quantclub?sslmode=verify-full&sslrootcert=/run/secrets/postgres_tls_ca
BACKTEST_DATABASE_URL=postgresql+psycopg://milkyway_backtest:replace-with-url-encoded-backtest-password@postgres:5432/quantclub?sslmode=verify-full&sslrootcert=/run/secrets/postgres_tls_ca
SCHEDULER_DATABASE_URL=postgresql+psycopg://milkyway_scheduler:replace-with-url-encoded-scheduler-password@postgres:5432/quantclub?sslmode=verify-full&sslrootcert=/run/secrets/postgres_tls_ca
# Same authority-only URL goes to the broker VM, never app/worker containers.
AUTHORITY_DATABASE_URL=postgresql+psycopg://milkyway_authority:replace-with-url-encoded-authority-password@db.private.internal.example:5432/quantclub?sslmode=verify-full&sslrootcert=/run/secrets/postgres_tls_ca
APP_VM_PRIVATE_IP=10.0.1.10
POSTGRES_TLS_CERT_PATH=/opt/milkyway/secrets/postgres-tls.crt
POSTGRES_TLS_KEY_PATH=/opt/milkyway/secrets/postgres-tls.key
POSTGRES_TLS_CA_PATH=/opt/milkyway/secrets/postgres-tls-ca.crt

SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_HOURS=12
# The public SESSION_SECRET is used only for private rate-limit identities.
# Create invitations in the authority environment with its separate SESSION_SECRET.
LEGACY_CLUB_INVITE_ENABLED=false

DATASET_DIR=/app/data_cache/backtest_datasets/2026_equities_pit_20260824
STAGING_DATA_PATH=/opt/milkyway/data_staging
PROMOTED_DATA_ROOT=/opt/milkyway/promoted_data
# Set this to the exact generation-* directory printed by data-promote.
PROMOTED_DATA_PATH=/opt/milkyway/promoted_data/generation-REPLACE_AFTER_REVIEW
SNAPSHOTS_GLOB=/app/data_cache/universe_snapshots/*.json
TERMINAL_EVENTS_PATH=/app/data_cache/universe_events/events.jsonl
SECTOR_MAP_PATH=/app/data_cache/_sector_map.json
# A scheduled provider can atomically replace this cache; the web app never
# fans out one external news request per signed-in member.
NEWS_FEED_PATH=/app/data_cache/news/news_feed.json

# Legacy shared-quote defaults. Production authority work always uses each
# member's verified connection; mock is not a personal-quote fallback.
QUOTE_PROVIDER=mock
QUOTE_INTERVAL_SECONDS=10
MARKET_DATA_SHARING_ALLOWED=false
KIS_ENVIRONMENT=paper

# Separate HTTPS origin, reachable by club browsers for /credentials.
# Use three independent 32+ character role tokens; each runtime gets its own.
CREDENTIAL_BROKER_URL=https://credential-broker.internal.example
CREDENTIAL_BROKER_APP_TOKEN=replace-with-at-least-32-random-characters
CREDENTIAL_BROKER_PAPER_TOKEN=replace-with-a-different-32-plus-random-value
CREDENTIAL_BROKER_BACKTEST_TOKEN=replace-with-another-distinct-32-plus-random-value
AI_TIMEOUT_SECONDS=120

LOCAL_AI_MAX_CONCURRENT_REQUESTS=4

MAX_BACKTESTS_PER_USER_DAY=20
MAX_OUTSTANDING_BACKTESTS_PER_USER=2
MAX_OUTSTANDING_BACKTESTS_TOTAL=40
MAX_BACKTEST_RESULT_BYTES=1048576
MAX_COMPLETED_BACKTESTS_PER_USER=50
BACKTEST_RETENTION_DAYS=30
BACKTEST_TIMEOUT_SECONDS=300
MAX_STRATEGIES_PER_USER=10
MAX_ACCOUNTS_PER_USER=3
MAX_USERS=40
WORKER_STALE_SECONDS=90
MAX_REQUEST_BODY_BYTES=16384
MAX_REQUEST_BODY_MESSAGES=64
REQUEST_BODY_READ_TIMEOUT_SECONDS=15
MAX_STREAMS_PER_USER=2
MAX_STREAMS_TOTAL=64
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=10
PASSWORD_MAX_CONCURRENT_REQUESTS=4
REGISTRATION_GLOBAL_ATTEMPTS=20
LOGIN_ACCOUNT_ATTEMPTS=10
LOGIN_ACCOUNT_WINDOW_SECONDS=600
LOGIN_GLOBAL_ATTEMPTS=400
SHARED_QUOTE_BATCH_SIZE=200
SHARED_QUOTE_MAX_SYMBOLS_PER_TICK=200
QUOTE_MAX_CONCURRENT_REQUESTS=8
SHARED_QUOTE_TICK_DEADLINE_SECONDS=30
QUOTE_MAX_AGE_SECONDS=180
BACKUP_PUBLIC_KEY_PATH=/opt/milkyway/secrets/backup-public.pem
LOG_LEVEL=INFO
